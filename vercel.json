{
  "build": {
    "env": {
      "VITE_CONFIG_NATIVE_IGNORE_WARNING": "true"
    }
  },
  "installCommand": "npm install --legacy-peer-deps --loglevel=error --no-fund --no-audit",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
