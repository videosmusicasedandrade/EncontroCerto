rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global catch-all safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Coleção de Usuários
    match /usuarios/{usuarioId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(usuarioId);
      allow update: if (isOwner(usuarioId) || isAdmin()) && isValidId(usuarioId);
      allow delete: if isAdmin();
    }

    // Coleção de Certcoin Lotes
    match /lotes/{loteId} {
      allow read: if isSignedIn() && (resource.data.usuario_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.usuario_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Coleção de Posts no Feed
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.usuario_id == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.usuario_id == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['curtidas'])
      );
      allow delete: if isSignedIn() && (resource.data.usuario_id == request.auth.uid || isAdmin());
    }

    // Coleção de Mensagens
    match /mensagens/{mensagemId} {
      allow read: if isSignedIn() && (
        resource.data.remetente_id == request.auth.uid || 
        resource.data.destinatario_id == request.auth.uid || 
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.remetente_id == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
